# Servidor
PORT=4000
NODE_ENV=development

# Base de datos Supabase / PostgreSQL
# Transaction Pooler (ideal para Vercel - conexión por petición)
DATABASE_URL="postgresql://***REMOVED***:***REMOVED***@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Seguridad - JWT
JWT_SECRET="***REMOVED***"
JWT_EXPIRES_IN="7d"

# CORS - URL del Frontend
FRONTEND_URL="http://localhost:5173"
