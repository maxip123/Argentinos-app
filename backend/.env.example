# Servidor
PORT=4000
NODE_ENV=development

# Base de datos Supabase / PostgreSQL
# Transaction Pooler (ideal para Vercel - conexión por petición)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Seguridad - JWT
JWT_SECRET="GENERAR_UNA_CLAVE_PROPIA"
JWT_EXPIRES_IN="7d"

# CORS - URL del Frontend
FRONTEND_URL="http://localhost:5173"

# Solo para scripts/seed_demo.js y scripts/test_flow_complete.js
ADMIN_EMAIL="EMAIL_DEL_ADMIN"
ADMIN_PASSWORD="CONTRASENA_DEL_ADMIN"
